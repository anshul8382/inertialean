#!/usr/bin/env bash
# Use repo-bundled Node (apps/mobile/.node-local) when system npm is not installed.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
NODE_BIN="$ROOT/../mobile/.node-local/bin"
if [[ ! -x "$NODE_BIN/npm" ]]; then
  echo "Node not found at $NODE_BIN/npm"
  echo "Install Node 18+ from https://nodejs.org or: brew install node"
  exit 1
fi
export PATH="$NODE_BIN:$PATH"
cd "$ROOT"
exec npm "$@"
