[Unit]
Description=Airflow API Server - Inertia Lean VPS
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=anshul
Group=anshul
WorkingDirectory=/opt/Inertia2026v1

Environment=INERTIA_APP_DIR=/opt/Inertia2026v1
Environment=AIRFLOW_HOME=/opt/Inertia2026v1/airflow
Environment=AIRFLOW_CONFIG=/opt/Inertia2026v1/airflow/airflow.cfg
Environment=AIRFLOW__CORE__EXECUTOR=SequentialExecutor
Environment=AIRFLOW__CORE__DAGS_FOLDER=/opt/Inertia2026v1/airflow/dags
Environment=AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/Inertia2026v1/airflow/logs
Environment=AIRFLOW__EMAIL__SUBJECT_TEMPLATE=/opt/Inertia2026v1/airflow/email_templates/failure_subject.jinja2
Environment=AIRFLOW__API__PORT=8080
Environment=PATH=/opt/Inertia2026v1/airflow_venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/opt/Inertia2026v1/.env

# Bind localhost only — use SSH tunnel for UI
ExecStart=/opt/Inertia2026v1/airflow_venv/bin/airflow api-server -H 127.0.0.1 -p 8080

Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Prefer journal if file logs have permission issues; file path must be writable by User=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
