# Production v2026 stack — Gunicorn on 127.0.0.1:5004 (Apache :443 proxies here).
# Install: sudo cp config/inertia-2026v1.service /etc/systemd/system/
#         sudo systemctl daemon-reload && sudo systemctl enable --now inertia-2026v1
#
# Override paths on server if not using /opt/Inertia2026v1.

[Unit]
Description=Inertia App v2026 (production Gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=inertia
Group=inertia
WorkingDirectory=/opt/Inertia2026v1
EnvironmentFile=-/opt/Inertia2026v1/.env
Environment="PATH=/opt/Inertia2026v1/venv/bin"
ExecStart=/opt/Inertia2026v1/venv/bin/python3 -m gunicorn -c /opt/Inertia2026v1/config/gunicorn_parallel_v2026.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inertia-2026v1
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/Inertia2026v1

[Install]
WantedBy=multi-user.target
